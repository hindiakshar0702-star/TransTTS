generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  // Null for accounts created via OAuth only (no local password).
  passwordHash String?
  // "user" | "admin" — SQLite has no enums, enforce in app layer.
  role         String   @default("user")
  // "credentials" | "google" — how the account first signed up.
  provider     String   @default("credentials")
  image        String?

  // Independent verification flags — a user may verify email, phone, both, or
  // neither. Never authorization-bearing on their own; gate features as needed.
  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  // Bumped on password reset / "log out everywhere". Sessions carry this value
  // in their JWT; getSessionUser rejects any token whose value is stale, which
  // invalidates every previously-issued session at once.
  tokenVersion Int      @default(0)

  // Editable profile fields (all user-controlled, never authorization-bearing).
  // Phone is unique when set (nullable — Postgres allows many NULLs) and stored
  // in E.164 format; ownership is proven via the phoneVerified flag + OTP.
  phone        String?  @unique
  jobTitle     String?
  organization String?
  bio          String?
  defaultLang  String?
  defaultVoice String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  jobs         Job[]
  resetTokens  PasswordResetToken[]
  otpCodes     OtpCode[]
}

model OtpCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "EMAIL" | "MOBILE" — enforced in app layer (matches role/provider style).
  type      String
  // Destination the code was sent to: email address or E.164 phone number.
  target    String
  // Only the SHA-256 hash of the 6-digit code is stored — never the plaintext.
  otpHash   String
  expiresAt DateTime
  // Failed verification attempts; the code is invalidated past the max.
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([target, type])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // We store ONLY the SHA-256 hash of the token; the raw token lives only in the
  // emailed link. A DB leak therefore cannot be used to reset anyone's password.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Job {
  id         String   @id @default(uuid())
  // Nullable: legacy jobs created before auth have no owner.
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // "transcribe" | "translate" | "tts"
  title      String
  status     String   @default("processing") // "processing" | "completed" | "error"
  progress   Int      @default(0)

  // Transcription fields
  fileName   String?
  fileSize   Int?
  language   String?
  duration   Float?
  transcript String?
  segments   String?  // JSON string

  // Translation fields
  sourceText     String?
  translatedText String?
  sourceLang     String?
  targetLang     String?
  engine         String?

  // TTS fields
  text       String?
  voice      String?
  audioUrl   String?
  // Hash of (text + voice + rate). Lets a repeat request reuse the audio this
  // job already produced instead of paying for synthesis again. Scoped per
  // user by the lookup, so one account clearing its history can never delete
  // audio another account is pointing at.
  cacheKey   String?

  errorMsg   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Jobs list queries filter by owner (+ optional type) and sort by newest.
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, type])
  // TTS cache lookup, and the cleanup sweep's audioUrl -> job resolution.
  @@index([userId, cacheKey])
  @@index([audioUrl])
}

/// Translation results keyed by a hash of (text + source + target).
/// Deterministic for a given input, so this is shared across users — only the
/// hash and the result are stored, never the source text.
model TranslationCache {
  key            String   @id
  translatedText String
  engine         String?
  createdAt      DateTime @default(now())
  /// Bumped on every reuse so a sweep can evict entries nobody asks for.
  lastUsedAt     DateTime @default(now())
  hitCount       Int      @default(0)

  @@index([lastUsedAt])
}
