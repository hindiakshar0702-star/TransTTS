generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Job {
  id         String   @id @default(uuid())
  type       String   // "transcribe" | "translate" | "tts"
  title      String
  status     String   @default("processing") // "processing" | "completed" | "error"
  progress   Int      @default(0)

  // Transcription fields
  fileName   String?
  fileSize   Int?
  language   String?
  duration   Float?
  transcript String?
  segments   String?  // JSON string

  // Translation fields
  sourceText     String?
  translatedText String?
  sourceLang     String?
  targetLang     String?
  engine         String?

  // TTS fields
  text       String?
  voice      String?
  audioUrl   String?

  errorMsg   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Order {
  id                String   @id @default(uuid())

  // Which payment provider handled this order: "razorpay" | "phonepe"
  provider          String   @default("razorpay")

  // -------- Razorpay-specific fields --------
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?
  razorpaySignature String?

  // -------- PhonePe-specific fields --------
  // Our own merchant txn id sent in payload (max 38 chars, alphanumeric)
  phonepeMerchantTransactionId String? @unique
  // PhonePe's transaction id from status response (after success)
  phonepeTransactionId         String?
  // PhonePe's providerReferenceId (e.g. UPI utr / bank reference)
  phonepeProviderReferenceId   String?

  // -------- Common fields --------
  plan              String   // "starter" | "pro" | "enterprise"
  cycle             String   // "monthly" | "yearly"
  amount            Int      // in paise (₹1 = 100 paise)
  currency          String   @default("INR")
  status            String   @default("created") // "created" | "paid" | "failed" | "refunded"

  userEmail         String?
  userName          String?
  userPhone         String?  // optional, used by PhonePe prefill

  // Subscription validity (set when paid)
  validUntil        DateTime?

  // Provider webhook payloads (raw JSON for audit)
  webhookEvent      String?
  errorMsg          String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userEmail])
  @@index([status])
  @@index([provider])
}
