# Keep the build context small and never ship secrets or local state.
node_modules
.next
out
build

# Secrets — provided as runtime environment variables instead.
.env
.env.*
!.env.example

# Local database + generated/scratch state
.local-pg
uploads
generated

# VCS / editor / OS
.git
.gitignore
.vscode
.idea
.DS_Store

# Tests and reports (not needed in the image)
tests
test-results
playwright-report
playwright.config.ts

# Docs and CI
docs
.github
README.md
*.md
!prisma/**/*.md
