# TransTTS (free/serverless variant) — environment variables.
# Copy to .env.local for development. In production set these in the hosting
# dashboard. There is no database, no login, and no secrets to protect beyond
# the API keys below.

# ─────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────

# Groq (console.groq.com, free tier) powers BOTH Whisper transcription and
# LLM translation. Without it, translation is disabled and transcription falls
# back to OPENAI_API_KEY if that is set. TTS (Microsoft Edge voices) is free
# and needs no key.
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Optional: override the Groq chat model used for translation, so a
# decommissioned model id can be swapped without a code change.
GROQ_TRANSLATE_MODEL=""

# Public origin, no trailing slash — used for canonical URLs, the sitemap and
# Open Graph tags. NEXT_PUBLIC_APP_URL is inlined at BUILD time, so it must be
# set before `next build`, not only at runtime.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# OPTIONAL — contact form delivery
# ─────────────────────────────────────────────────────────────
# Without a transport, contact messages are only written to the server log.
# Option 1: SMTP (a normal mailbox with an app password is enough).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TransTTS <no-reply@example.com>"
# Option 2: Resend HTTP API, used when SMTP is not configured.
RESEND_API_KEY=""
# Where contact-form submissions are delivered (falls back to MAIL_FROM).
CONTACT_TO=""

# ─────────────────────────────────────────────────────────────
# OPTIONAL — misc
# ─────────────────────────────────────────────────────────────
# Largest upload accepted, in MB. Defaults to 4, which is what a Vercel
# serverless function can actually receive — the platform answers 413 above
# ~4.5MB before the route runs. Raise it (up to 25, Whisper's own cap) only on
# a host without that limit. Inlined at BUILD time.
NEXT_PUBLIC_MAX_UPLOAD_MB=""

# Google Search Console verification token ("HTML tag" method).
GOOGLE_SITE_VERIFICATION=""
# Monetag ad tag, if used.
NEXT_PUBLIC_MONETAG_ZONE_ID=""
NEXT_PUBLIC_MONETAG_VERIFICATION=""
