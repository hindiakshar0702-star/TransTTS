# TransTTS environment variables.
# Copy to .env.local for development. In production set these in the hosting
# dashboard — never commit real values (.env* is gitignored).

# ─────────────────────────────────────────────────────────────
# REQUIRED — the app will not work without these
# ─────────────────────────────────────────────────────────────

# Postgres. DIRECT_URL is used for migrations and must be a direct (non-pooled)
# connection; with a pooler, DATABASE_URL points at the pooled port.
DATABASE_URL="postgresql://user:password@host:5432/transtts?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/transtts?schema=public"

# Session signing key for Auth.js. Minimum 32 characters — anything shorter and
# every auth request fails. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Public origin, no trailing slash. Used for OAuth callbacks, canonical URLs,
# the sitemap and Open Graph tags. NEXT_PUBLIC_APP_URL is inlined at BUILD time,
# so it must be set before `next build`, not only at runtime.
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Whisper transcription. Either one works; Groq is checked first and has a free
# tier (console.groq.com). Without one of these, transcription returns an error.
GROQ_API_KEY=""
OPENAI_API_KEY=""

# ─────────────────────────────────────────────────────────────
# GOOGLE SIGN-IN — REQUIRED, this is the only way into the app
# ─────────────────────────────────────────────────────────────
# From Google Cloud Console -> Credentials -> OAuth client (type: Web
# application). Register <origin>/api/auth/callback/google as an authorised
# redirect URI, e.g. http://localhost:3000/api/auth/callback/google
#
# AUTH_GOOGLE_* is the Auth.js v5 convention and takes precedence; GOOGLE_CLIENT_*
# is the older name this project started with. Set ONE pair — leaving the other
# blank is fine, but do not half-fill a pair.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Legacy aliases, used only when the AUTH_GOOGLE_* pair is unset.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────
# EMAIL — OTP verification codes and contact-form delivery
# ─────────────────────────────────────────────────────────────
# Without a transport these messages are only written to the server log, so
# users never receive them and email verification will appear broken.
#
# Option 1: SMTP (a normal mailbox with an app password is enough).
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TransTTS <no-reply@example.com>"
#
# Option 2: Resend HTTP API, used when SMTP is not configured.
RESEND_API_KEY=""
#
# Where contact-form submissions are delivered (falls back to MAIL_FROM).
CONTACT_TO=""

# ─────────────────────────────────────────────────────────────
# SMS — optional, only for phone verification
# ─────────────────────────────────────────────────────────────
# Android phone gateway (development only), tried before Twilio.
SMS_GATEWAY_URL=""
SMS_GATEWAY_USER=""
SMS_GATEWAY_PASS=""
# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ─────────────────────────────────────────────────────────────
# OPTIONAL
# ─────────────────────────────────────────────────────────────

# Social-media video transcription shells out to yt-dlp. Leave unset if the
# binary is on PATH (the Docker image installs it).
YT_DLP_PATH=""

# How long generated TTS audio is kept before the cleanup sweep removes it and
# clears the job's audio link. Defaults to 7 days. Abandoned uploads are always
# dropped after an hour regardless of this setting.
MEDIA_TTL_DAYS="7"

# Google Search Console verification token ("HTML tag" method).
GOOGLE_SITE_VERIFICATION=""

# Monetag ad tag, if used.
NEXT_PUBLIC_MONETAG_ZONE_ID=""
NEXT_PUBLIC_MONETAG_VERIFICATION=""

# DEVELOPMENT ONLY. Exposes /api/auth/otp/test-peek so tests can read OTP codes
# without a mail or SMS provider. MUST stay unset in production — the route
# returns 404 unless this is "1".
OTP_TEST_MODE=""

# DEVELOPMENT ONLY. Enables the `test-login` provider, which signs in any email
# WITHOUT VERIFICATION so Playwright can reach authenticated pages (Google's
# consent screen cannot be automated). This is a complete authentication
# bypass. It is ignored when NODE_ENV=production, but MUST stay unset in any
# deployed environment regardless.
AUTH_TEST_MODE=""
