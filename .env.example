# =============================================================================
# TransTTS — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# App URL — used by payment providers to build redirect / callback URLs.
# -----------------------------------------------------------------------------
# Local dev:        http://localhost:3000
# Vercel preview:   https://<branch>-<project>.vercel.app
# Production:       https://your-domain.com
#
# Required for PhonePe (which needs absolute redirect URLs).
# Optional for Razorpay (only used if set).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local dev (SQLite — works out of the box):
DATABASE_URL="file:./dev.db"

# Production (Vercel / serverless) — use Postgres. Examples:
#   Vercel Postgres:  DATABASE_URL="postgres://..."
#   Supabase:         DATABASE_URL="postgresql://...?pgbouncer=true"
#   Neon:             DATABASE_URL="postgres://...?sslmode=require"
#
# When switching to Postgres, also change `provider` to `postgresql` in
# prisma/schema.prisma and re-run `npx prisma migrate dev --name init`.

# -----------------------------------------------------------------------------
# Razorpay (https://dashboard.razorpay.com/app/keys)
# -----------------------------------------------------------------------------
# Server-side (NEVER expose to the browser):
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Client-side (safe to expose; same value as RAZORPAY_KEY_ID):
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Webhook secret (set in Razorpay dashboard → Webhooks → Add new webhook):
RAZORPAY_WEBHOOK_SECRET=any_long_random_string_you_set_in_dashboard

# -----------------------------------------------------------------------------
# PhonePe Payment Gateway (https://business.phonepe.com)
# -----------------------------------------------------------------------------
# Get these from PhonePe Business Dashboard → Developer Settings → API Keys.
# Leave UNSET in development to use PhonePe's public sandbox test creds
# (PGTESTPAYUAT) — works out of the box for UAT testing.
#
# Server-side only (NEVER expose to the browser):
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1

# Environment selector: "UAT" for sandbox, "PROD" for live.
# Default is "UAT" if unset.
PHONEPE_ENV=UAT

# -----------------------------------------------------------------------------
# AI providers (used by transcription/translation routes)
# -----------------------------------------------------------------------------
# Free tier — Groq Whisper (https://console.groq.com)
GROQ_API_KEY=

# Optional — paid OpenAI Whisper fallback (https://platform.openai.com)
OPENAI_API_KEY=
